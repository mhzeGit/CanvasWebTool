{
  "name": "canvaswebtool",
  "version": "1.0.0",
  "description": "Canvas whiteboard/diagramming tool — desktop app, web app and agent CLI",
  "main": "electron/main.mjs",
  "type": "commonjs",
  "bin": {
    "canvas": "bin/canvas.mjs"
  },
  "scripts": {
    "vendor": "node tools/vendor-deps.mjs",
    "postinstall": "node tools/vendor-deps.mjs",
    "serve": "python serve.py --port 5173",
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "dist:dir": "electron-builder --win --dir",
    "test": "node --test \"test/**/*.test.mjs\"",
    "smoke": "electron tools/smoke.mjs",
    "bench": "electron tools/bench-idle.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhzeGit/CanvasWebTool.git"
  },
